# All optional. Defaults shown.
NEXT_PUBLIC_INDEXER_URL=https://trisara-indexer.onrender.com
NEXT_PUBLIC_SIGNAL_URL=https://trisara-signal-api.onrender.com
NEXT_PUBLIC_REPO_URL=https://github.com/parvagrwal/Trisara
# Set when the site is served from a sub-path, e.g. /trisara (no trailing slash).
NEXT_PUBLIC_BASE_PATH=
# Waitlist: POST {"email": "..."} as JSON. Leave empty to render no form.
NEXT_PUBLIC_WAITLIST_ENDPOINT=
# Canonical site URL for metadata, e.g. https://trisara.example
NEXT_PUBLIC_SITE_URL=

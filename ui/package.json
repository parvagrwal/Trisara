{
  "name": "trisara-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-deployments.mjs",
    "predev": "node scripts/sync-deployments.mjs --if-present",
    "dev": "next dev",
    "prebuild": "node scripts/sync-deployments.mjs --if-present",
    "build": "next build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "contrast": "node scripts/contrast.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && node scripts/check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}

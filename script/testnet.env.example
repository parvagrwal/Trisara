# Copy to .env (NEVER commit .env) and fill in. Used by script/deploy-testnet.sh
PRIVATE_KEY=0x...
DEPLOYER=0x...
RPC_URL=https://...

# Optional: override chain anchor (0 = EQUITY_US for RH/HL, 1 = BANK_US for Tempo)
# ANCHOR=0
# Optional: gas limit per deploy (Tempo Moderato needs explicit)
# GAS_LIMIT=3000000

# --- Tier 2: feed-dependent adapters ---
# FEED_HIMS=0x...            # testnet Chainlink-style HIMS/USD feed
# POOL_HIMS_USDC=0x...       # testnet HIMS/USDC pool
# HL_ASSET_INDEX=0           # HyperEVM testnet perp index (chain 998 only)
# TEMPO_DEX=0x...            # Tempo testnet DEX quoter (chain 42431 only)
# TEMPO_TARGET=0x...         # Tempo peg target token (defaults to FEE_TOKEN)

# --- Tier 3: consumers ---
# TOKEN_USDC=0x...           # testnet USDC
# TOKEN_HIMS=0x...           # testnet HIMS
# VENUE_FEED=0x...           # venue feed (defaults to FEED_HIMS)
# FEE_TOKEN=0x...            # Tempo testnet fee token (pathUSD on 42431)
# POLICY=0x...               # TIP-403 policy (defaults to DEPLOYER)
# PEG_ADAPTER=0x...          # peg adapter (defaults to ReferenceFeedAdapter)
# REF_PX=3467028             # reference price for GuardedSwapRouter (feed decimals)
